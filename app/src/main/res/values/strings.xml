    <string name="app_name">VisionAid AI</string>

    <!-- Notification channel -->
    <string name="notification_channel_name">VisionAid Active Monitoring</string>
    <string name="notification_channel_description">Keeps VisionAid AI running to relay obstacle warnings and voice commands from your wearable device</string>

    <!-- Notification content -->
    <string name="notification_title">VisionAid AI is active</string>
    <string name="notification_text">Monitoring your surroundings</string>

