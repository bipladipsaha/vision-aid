    <string name="gesture_announce_volume_up">Volume up</string>
    <string name="gesture_announce_volume_down">Volume down</string>

    <!-- TalkBack custom actions -->
    <string name="action_voice_command">Voice command</string>
    <string name="action_describe_scene">Describe scene</string>
    <string name="action_volume_up">Volume up</string>
    <string name="action_volume_down">Volume down</string>

    <!-- Future phases -->
    <string name="voice_listening">Listening for your command…</string>
    <string name="voice_processing">Processing…</string>
    <string name="thermal_warning">System running hot. Pausing vision AI.</string>
    <string name="battery_low_warning">Wearable battery low. %1$d percent remaining.</string>
