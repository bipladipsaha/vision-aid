<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground Service (always-alive backbone) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Queries for Text-To-Speech, Speech Recognition, and app visibility on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- WhatsApp deep link -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Dialer -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- SMS -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Bluetooth communication with Pi wearable -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Offline voice recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- USB tethering / WebSocket fallback / WhatsApp API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep alive in pocket -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Telephony: Make and manage calls -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Contacts: Resolve spoken names to phone numbers -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SMS: Send text messages -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- App Launcher: Query installed apps by name -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".VisionAidApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VisionAidAI"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- USB accessory intent for Pi hardware button (Phase 7) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.VisionAidService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- ============================================== -->
        <!--  DIGITAL ASSISTANT OS INTEGRATION              -->
        <!-- ============================================== -->

        <!-- The main entry point to register as a default assistant -->
        <service
            android:name=".assistant.VisionAidAssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>

        <!-- The session service that handles the power button overlay -->
        <service
            android:name=".assistant.VisionAidSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Dummy recognition service required by the OS to validate the assistant -->
        <service
            android:name=".assistant.VisionAidRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- ============================================== -->
        <!--  INCOMING CALL ANNOUNCER                       -->
        <!-- ============================================== -->

        <receiver
            android:name=".telephony.IncomingCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

